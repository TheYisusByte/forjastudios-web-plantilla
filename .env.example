# ── WordPress headless (doc 03 · ver wordpress/README.md) ────────────────────
# Si WP_GRAPHQL_URL está definido, el front consume WordPress (WPGraphQL).
# Si se deja vacío, usa el mock bilingüe tipado (src/lib/content/data.ts).

# Endpoint GraphQL (single-site en api.forjastudios.com)
WP_GRAPHQL_URL=https://api.forjastudios.com/graphql

# Base pública de WordPress (para imágenes / preview)
NEXT_PUBLIC_WP_URL=https://api.forjastudios.com

# Secreto compartido para preview de borradores desde WP (doc 02)
WP_PREVIEW_SECRET=

# Credenciales de la REST API de WordPress. Solo las usan los scripts de
# mantenimiento (scripts/wp-video-posters.py); el sitio no las necesita.
# La clave es una "Contraseña de aplicación": Usuarios → Perfil → Contraseñas
# de aplicación (no la contraseña de la cuenta).
WORDPRESS_USER=
WORDPRESS_KEY=

# Secreto del webhook WP → revalidateTag('site-content') / revalidatePath.
# El MISMO valor va en Vercel y en WordPress (Ajustes → Forja Headless).
# Generar uno con:  openssl rand -hex 32
REVALIDATE_SECRET=

# Red de seguridad del ISR, en segundos (por defecto 300 = 5 min): cada cuánto
# se refresca el contenido de WP aunque el webhook no llegue. 0 = solo webhook.
WP_REVALIDATE_SECONDS=300

# Envío del formulario de contacto (Server Action → Resend)
RESEND_API_KEY=

# Google Analytics 4 — ID de medición. Opcional: el layout ya trae el ID de
# producción por defecto. Solo hace falta definirlo para apuntar a otra
# propiedad (staging, pruebas). Se ignora fuera de producción.
NEXT_PUBLIC_GA_ID=
